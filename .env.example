# Dev local: MySQL corre en Docker con mapeo 3307:3306 → usar 3307 desde el host
# En Docker (docker-compose): DB_HOST y DB_PORT se sobreescriben automáticamente
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=fitness_platform
DB_PORT=3307

PORT=3000
NODE_ENV=development

JWT_SECRET=
SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

GMAIL_USER=
GMAIL_APP_PASSWORD=

# IA — Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
