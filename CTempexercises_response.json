5-d05b474e2155?w=400","descripcion":"El rey de los ejercicios de pierna. Baja hasta que la cadera rompa el paralelo.","tipo":"Fuerza / Hipertrofia","puntos_clave":null},{"id":20,"musculo_id":21,"titulo":"Zancadas (Lunges)","dificultad":"Media","imagen":"https://images.unsplash.com/photo-1434682881908-b43d0467b798?w=400","descripcion":"Da un paso largo y baja la rodilla trasera casi hasta tocar el suelo.","tipo":"Fuerza / Hipertrofia","puntos_clave":null}]